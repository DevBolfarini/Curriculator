# 🔐 TEMPLATE de Variáveis de Ambiente
# 
# ⚠️ IMPORTANTE: Este é apenas um EXEMPLO!
# 
# 1. Copie este arquivo como `.env`:
#    cp .env.example .env
#
# 2. Substitua os valores pelos seus próprios:
#    GOOGLE_API_KEY = "sua_chave_real_aqui"
#
# 3. NUNCA faça commit do arquivo `.env`!
#    (Ele está em .gitignore)

# Google Gemini API Key
# Obtenha em: https://ai.google.dev/
GOOGLE_API_KEY="sua_chave_api_aqui"

# Opcional: Para integração futura com banco externo
